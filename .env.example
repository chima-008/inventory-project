APP_NAME="Inventory Dashboard API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Local development uses PostgreSQL.
# Production uses the DB_URL variable provided by the hosting platform.

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=inventory_project
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# Production example:
# DB_URL=postgresql://your_username:your_password@your_host/your_database

# --------------------------------------------------------------------------
# Session / Cache / Queue
# --------------------------------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --------------------------------------------------------------------------
# Redis
# --------------------------------------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------------------------------
# Mail
# --------------------------------------------------------------------------
# Configure these values for your SMTP provider.
# Never commit real credentials.

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=your_smtp_host
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_FROM_ADDRESS=your_sender_email@example.com
MAIL_FROM_NAME="Inventory Dashboard"

# --------------------------------------------------------------------------
# Frontend
# --------------------------------------------------------------------------

FRONTEND_URL=http://localhost:3000

# --------------------------------------------------------------------------
# Google OAuth
# --------------------------------------------------------------------------
# Required only if Google authentication is enabled.

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback

# --------------------------------------------------------------------------
# Brevo API
# --------------------------------------------------------------------------
# Required if the application sends email through the Brevo API.

BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_sender_email@example.com
BREVO_SENDER_NAME="Inventory Dashboard"

# --------------------------------------------------------------------------
# Storage / AWS
# --------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------------------------------
# Vite
# --------------------------------------------------------------------------

VITE_APP_NAME="${APP_NAME}"
